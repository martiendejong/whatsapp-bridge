<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Kept in sync with the repo-root VERSION file by deploy/bump-version.ps1 on each release -->
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Dawa: C# WhatsApp client (source lives in /Dawa, no external repo dependency) -->
    <ProjectReference Include="..\..\Dawa\Dawa.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Baked into the DLL so /api/ai-docs is deploy-proof — no reliance on a loose file being copied to the publish output -->
    <EmbeddedResource Include="..\..\AI-INTEGRATION.md" LogicalName="AI-INTEGRATION.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Baileys sidecar (Node.js) travels with the publish output so BaileysEngine finds it
         next to the DLL. node_modules is installed server-side (deploy.py runs npm install). -->
    <Content Include="..\..\baileys-sidecar\index.js" Link="baileys-sidecar\index.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\baileys-sidecar\package.json" Link="baileys-sidecar\package.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
